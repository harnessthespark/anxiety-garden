# Copy this file to ".env" and uncomment the line you want. NEVER commit the real .env
# (it's in .gitignore). This file is just the template.

# --- Local SQLite (default) ---
# Leave DATABASE_URL unset and the app uses sqlite:///./garden.db automatically.

# --- Local Postgres (Lesson 3, after `docker compose up -d`) ---
# DATABASE_URL=postgresql+psycopg://garden:garden@localhost:5432/garden

# --- Production (Coolify) ---
# Set DATABASE_URL in the Coolify dashboard to your Postgres resource's connection
# string (use the internal Docker host Coolify gives you), e.g.:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/garden
